# Copy thành .env (không commit). Đổi xong phải chạy lại Metro: pnpm start --reset-cache
# Bỏ trống / không có .env -> dùng backend production (https://ar-backend-vkdz.onrender.com).

# Backend production
# API_URL=https://ar-backend-vkdz.onrender.com

# Backend local qua cáp USB: chạy thêm `adb reverse tcp:3000 tcp:3000` (bản debug cho phép http)
# API_URL=http://localhost:3000

# Backend local qua Wi-Fi: IP LAN của máy chạy backend (ipconfig), điện thoại cùng mạng
# API_URL=http://192.168.1.10:3000
